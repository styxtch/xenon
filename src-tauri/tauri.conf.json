{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XENON",
  "version": "1.0.0",
  "identifier": "com.xenon.pdfworkspace",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XENON — Private PDF Workspace",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "decorations": true,
        "backgroundColor": "#151517"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**", "$APPDATA/**", "$DOCUMENT/**"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost xenon: http://xenon.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost xenon: http://xenon.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/qpdf",
      "binaries/gs"
    ],
    "resources": [
      "resources/lib/*",
      "resources/icc/*",
      "resources/tessdata/*",
      "resources/integrity-manifest.json"
    ]
  }
}
